<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<% request.setAttribute("pageTitle", pageTitle); %>
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${pageTitle}"/> · Restaurant Management System</title>
    <link rel="stylesheet" href="<%= root %>/assets/app.css">
</head>
<body>
<header class="banner">
    <div class="banner-inner">
        <a class="brand" href="<%= root %>/index.jsp">Restaurant Management System</a>
        <c:choose>
        <c:when test="${empty sessionScope.manager}">
            <a class="button banner-button" href="<%= root %>/LoginFrm1.jsp">Login</a>
        </c:when>
        <c:otherwise>
            <form class="banner-actions" method="post" action="<%= root %>/doLogout.jsp">
                <input type="hidden" name="csrfToken" value="<%= html(csrfToken) %>">
                <span><c:out value="${sessionScope.manager.fullname}"/></span>
                <button class="button banner-button" type="submit">Logout</button>
            </form>
        </c:otherwise>
        </c:choose>
    </div>
</header>
